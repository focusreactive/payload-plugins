{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@payload-config": ["./payload.config.ts"],
      "@focus-reactive/payload-plugin-folders": ["../src/index.ts"],
      "@focus-reactive/payload-plugin-folders/client": ["../src/exports/client.ts"],
      "@focus-reactive/payload-plugin-folders/rsc": ["../src/exports/rsc.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs",
    "../src/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

{
  "name": "@focus-reactive/payload-plugin-folders",
  "version": "0.0.0",
  "private": true,
  "description": "Storyblok-style content tree for Payload 4: folders, per-folder ordering, full paths, moves with redirects.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/focusreactive/payload-plugins",
    "directory": "packages/payload-plugin-folders"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./server": {
      "import": "./src/server/index.ts",
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./rsc": {
      "import": "./src/exports/rsc.ts",
      "types": "./src/exports/rsc.ts",
      "default": "./src/exports/rsc.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json",
    "dev": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts next dev dev --port 4078",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "seed": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload run ./dev/seed.ts",
    "generate:importmap": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload generate:importmap",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload generate:types",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:int:postgres": "cross-env TEST_DB=postgres vitest run --project int",
    "test:perf": "vitest run --project perf",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1"
  },
  "devDependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.5",
    "@payloadcms/db-sqlite": "4.0.0-beta.5",
    "@payloadcms/next": "4.0.0-beta.5",
    "@payloadcms/plugin-redirects": "4.0.0-beta.5",
    "@payloadcms/ui": "4.0.0-beta.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "graphql": "16.14.2",
    "jsdom": "25.0.1",
    "next": "16.4.2",
    "payload": "4.0.0-beta.5",
    "pg": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^4.0.0-beta.5",
    "payload": "^4.0.0-beta.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./rsc": {
        "import": "./dist/exports/rsc.js",
        "types": "./dist/exports/rsc.d.ts",
        "default": "./dist/exports/rsc.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}

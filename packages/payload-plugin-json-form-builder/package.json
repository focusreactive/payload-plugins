{
  "name": "@focus-reactive/payload-plugin-json-form-builder",
  "version": "1.0.1",
  "private": false,
  "description": "Edit a Payload JSON field as real admin fields. The shape lives in the value, is built in a drawer, and the site reads plain values by key",
  "license": "MIT",
  "author": "FocusReactive <ship@focusreactive.com>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rsc": {
      "import": "./dist/rsc.js",
      "types": "./dist/rsc.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./shared": {
      "import": "./dist/shared.js",
      "types": "./dist/shared.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "json",
    "json-field",
    "json-editor",
    "schema-less",
    "form-builder",
    "admin-ui",
    "rich-text",
    "lexical",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/focusreactive/payload-plugins",
    "directory": "packages/payload-plugin-json-form-builder"
  },
  "bugs": {
    "url": "https://github.com/focusreactive/payload-plugins/issues"
  },
  "homepage": "https://github.com/focusreactive/payload-plugins/tree/main/packages/payload-plugin-json-form-builder",
  "scripts": {
    "build": "bun run build:swc && bun run build:types && bun run copyfiles",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "copyfiles": "copyfiles -u 1 \"src/**/*.scss\" dist",
    "check-types": "tsgo --noEmit",
    "clean": "rm -rf dist",
    "dev": "bun run build:swc -- --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "^3.84.0",
    "@payloadcms/ui": "^3.84.0",
    "payload": "^3.84.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/richtext-lexical": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@swc/cli": "0.4.0",
    "@swc/core": "1.7.0",
    "@types/react": "19.2.9",
    "copyfiles": "2.4.1",
    "payload": "3.84.1",
    "react": "19.2.1",
    "typescript": "5.9.2"
  }
}

{
  "name": "@focus-reactive/payload-plugin-visual-editing",
  "version": "1.0.0",
  "description": "Visual editing for Payload CMS — click-to-edit overlays on your frontend via Vercel stega and a postMessage bridge back to the admin.",
  "license": "MIT",
  "author": "FocusReactive <ship@focusreactive.com>",
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "visual-editing",
    "click-to-edit",
    "live-preview",
    "stega",
    "nextjs"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/focusreactive/payload-plugins",
    "directory": "packages/payload-plugin-visual-editing"
  },
  "bugs": {
    "url": "https://github.com/focusreactive/payload-plugins/issues"
  },
  "homepage": "https://github.com/focusreactive/payload-plugins/tree/main/packages/payload-plugin-visual-editing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./admin": {
      "import": "./dist/admin/index.js",
      "types": "./dist/admin/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "admin": [
        "./dist/admin/index.d.ts"
      ],
      "client": [
        "./dist/client/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "bun run build:swc && bun run build:types",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "dev": "bun run build:swc -- --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsgo --noEmit"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.79.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "payload": "^3.79.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@vercel/stega": "^1.1.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.90.1",
    "@swc/cli": "0.4.0",
    "@swc/core": "1.7.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "next": "16.3.6",
    "payload": "3.90.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.0"
  }
}

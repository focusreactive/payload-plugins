{
  "name": "@focus-reactive/payload-plugin-workflows",
  "version": "1.0.0",
  "private": false,
  "description": "Editorial workflows for Payload CMS: stages, activities, actions, guards and effects defined in code, run by people and agents alike",
  "license": "MIT",
  "author": "FocusReactive <ship@focusreactive.com>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./rsc": {
      "import": "./dist/rsc.js",
      "types": "./dist/rsc.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "workflow",
    "editorial-workflow",
    "review",
    "approval",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/focusreactive/payload-plugins",
    "directory": "packages/payload-plugin-workflows"
  },
  "bugs": {
    "url": "https://github.com/focusreactive/payload-plugins/issues"
  },
  "homepage": "https://github.com/focusreactive/payload-plugins/tree/main/packages/payload-plugin-workflows",
  "scripts": {
    "build": "bun run build:swc && bun run build:types && bun run copyfiles",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "check-types": "tsgo --noEmit && tsgo --noEmit -p tests/tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "bun run build:swc -- --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "test": "vitest run",
    "copyfiles": "copyfiles -u 1 \"src/**/*.css\" dist"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.84.0",
    "@payloadcms/ui": "^3.84.0",
    "next": "^15.0.0 || ^16.0.0",
    "payload": "^3.84.0",
    "react": "^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@payloadcms/next": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@swc/cli": "0.4.0",
    "@swc/core": "1.7.0",
    "@types/react": "19.2.9",
    "copyfiles": "2.4.1",
    "next": "16.3.6",
    "payload": "3.90.1",
    "react": "19.2.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.0",
    "zod": "^4.4.3"
  }
}

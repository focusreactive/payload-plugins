{
  "compilerOptions": {
    "target": "ES2022",
    // ES2022 alone, with no DOM and no @types/node in scope: a platform API reached for by
    // accident fails to compile rather than tying the kernel to a runtime.
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}

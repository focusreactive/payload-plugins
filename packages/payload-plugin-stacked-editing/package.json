{
  "name": "@focus-reactive/payload-plugin-stacked-editing",
  "version": "1.0.0",
  "private": false,
  "description": "Stacked, breadcrumb-navigated editing panels for nested Payload CMS blocks and arrays, built on Payload's own drawers and fields",
  "license": "MIT",
  "author": "FocusReactive <ship@focusreactive.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "blocks",
    "page-builder",
    "nested-editing",
    "breadcrumbs",
    "drawer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/focusreactive/payload-plugins",
    "directory": "packages/payload-plugin-stacked-editing"
  },
  "bugs": {
    "url": "https://github.com/focusreactive/payload-plugins/issues"
  },
  "homepage": "https://github.com/focusreactive/payload-plugins/tree/main/packages/payload-plugin-stacked-editing",
  "scripts": {
    "build": "bun run build:swc && bun run build:types",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "check-types": "tsgo --noEmit && tsgo --noEmit -p tests/tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "bun run build:swc -- --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.84.0",
    "payload": "^3.84.0",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.90.1",
    "@swc/cli": "0.4.0",
    "@swc/core": "1.7.0",
    "@types/react": "19.2.9",
    "jsdom": "^25.0.0",
    "payload": "3.90.1",
    "react": "19.2.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.0"
  }
}

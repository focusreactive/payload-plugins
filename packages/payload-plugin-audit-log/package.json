{
  "name": "@focus-reactive/payload-plugin-audit-log",
  "version": "0.1.0",
  "description": "Audit log for Payload CMS: who changed what and when, including API keys, AI agents, seeds and migrations",
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "audit-log",
    "activity-log",
    "cms"
  ],
  "license": "MIT",
  "author": "FocusReactive <ship@focusreactive.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/focusreactive/payload-plugins",
    "directory": "packages/payload-plugin-audit-log"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [

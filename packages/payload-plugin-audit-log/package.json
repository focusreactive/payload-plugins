    "format:check": "ultracite check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.90.0",
    "payload": "^3.90.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.90.1",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "payload": "3.90.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tsup": "8.0.0",
    "typescript": "5.0.2",
    "vitest": "^2.1.8"
  }

DATABASE_URL=postgres://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com

# Used to validate preview requests
PREVIEW_SECRET=PAYLOAD_PREVIEW_SECRET_HERE

# Vercel Blob Storage for media uploads. Leave empty to store files in public/media.
# Token format: vercel_blob_rw_<store-id>_<random>
# Use a separate store for local dev, or local uploads and deletes change production files.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# AI SEO: auto-fill meta title/description on Page create (optional)
OPENAI_API_KEY=OPENAI_API_KEY

# OIDC SSO (Auth0, Keycloak, Okta, etc.)
OIDC_ISSUER=https://your-tenant.auth0.com
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
# Optional; default: NEXT_PUBLIC_SERVER_URL + /api/auth/oidc/callback
OIDC_REDIRECT_URI=https://yourdomain.com/api/auth/oidc/callback
# Optional; default: openid profile email
OIDC_SCOPES=openid profile email
# Optional; recommended for Auth0
OIDC_USE_PKCE=true
# Optional; label on login button (e.g. Auth0). For client: NEXT_PUBLIC_OIDC_PROVIDER_NAME
OIDC_PROVIDER_NAME=Auth0
NEXT_PUBLIC_OIDC_PROVIDER_NAME=Auth0

# Analytics (payload-plugin-analytics) — GA4
# NEXT_PUBLIC_GA_MEASUREMENT_ID and GA4_MEASUREMENT_ID must be the same G- value.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Cookieless analytics (Plausible). The script is rendered only when the domain is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional; self-hosted script URL (default https://plausible.io/js/script.js)
NEXT_PUBLIC_PLAUSIBLE_SRC=

# OIDC: Keycloak groups → CMS roles (JSON). Default {"cms-admins":"admin","cms-editors":"user","cms-authors":"author"}
OIDC_ROLE_MAP=

# CT demo seed: password of the demo accounts (default ct-demo)
SEED_DEMO_PASSWORD=

# Media storage: "local" forces public/media even when BLOB_READ_WRITE_TOKEN is set
MEDIA_STORAGE=

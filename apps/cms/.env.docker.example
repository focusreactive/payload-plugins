# Copy to apps/cms/.env.docker — read by the `cms` service. Everything the application needs is here.

# Postgres: the compose service, or the client's shared instance (a new database or schema).
DATABASE_URL=postgres://ct:ct@postgres:5432/ct
PAYLOAD_SECRET=change-me-32-random-chars
NEXT_PUBLIC_SERVER_URL=http://localhost:8080
PREVIEW_SECRET=change-me
CRON_SECRET=change-me

# Media: leave empty to store uploads on the `media` volume (served by the edge proxy).
BLOB_READ_WRITE_TOKEN=

# Optional: AI translation + semantic search (the container reaches no internet by default).
OPENAI_API_KEY=

# Optional: Keycloak sign-in (compose --profile sso). Issuer as seen from the cms container.
OIDC_ISSUER=http://keycloak:8081/realms/ct
OIDC_CLIENT_ID=ct-cms
OIDC_CLIENT_SECRET=ct-cms-secret
OIDC_PROVIDER_NAME=Keycloak
NEXT_PUBLIC_OIDC_PROVIDER_NAME=Keycloak
OIDC_ROLE_MAP={"cms-admins":"admin","cms-editors":"user","cms-authors":"author"}

# Optional: cookieless analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
